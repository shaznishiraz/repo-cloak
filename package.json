{
  "name": "repo-cloak-cli",
  "version": "2.0.0",
  "description": "🎭 Selectively extract and anonymize files from repositories. Perfect for sharing code with AI agents without exposing proprietary details.",
  "type": "module",
  "bin": {
    "repo-cloak": "dist/cli.js",
    "cloak": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs",
    "test:watch": "vitest",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev",
    "release:check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:package"
  },
  "keywords": [
    "cli",
    "anonymize",
    "extract",
    "repository",
    "code",
    "privacy",
    "ai",
    "llm",
    "obfuscate",
    "cloak",
    "mask",
    "sanitize"
  ],
  "author": "iamshz97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaznishiraz/repo-cloak.git"
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "dependencies": {
    "ahocorasick": "1.0.2",
    "commander": "15.0.0",
    "glob": "14.0.3",
    "isbinaryfile": "5.0.7",
    "lodash-es": "4.18.1",
    "minimatch": "11.0.3",
    "open": "11.0.4",
    "p-limit": "7.3.3",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/signals": "2.11.4",
    "@types/ahocorasick": "1.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.20.5",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "21.0.4",
    "preact": "11.1.1",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
